    # Conformance tests for the harness's TOML parser (v2.2.0).
    Dependency(
        'buildtools/toml-test',
        'https://github.com/toml-lang/toml-test.git',
        'ce08da1ddb075d1c7596d663c7fcba9a2ae02c5c'),
]


def stamp_path(dep):
    return ROOT / (dep.target_folder + '.stamp')


def is_up_to_date(dep):
    stamp = stamp_path(dep)
    return stamp.exists() and stamp.read_text().strip() == dep.checksum


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def extract(archive, dest):
    shutil.rmtree(dest, ignore_errors=True)
    tmp = dest.with_name(dest.name + '.extract')
    shutil.rmtree(tmp, ignore_errors=True)
    if zipfile.is_zipfile(archive):
        with zipfile.ZipFile(archive) as z:
            z.extractall(tmp)
        for f in tmp.rglob('*'):
            f.chmod(f.stat().st_mode | 0o755)
    else:
        with tarfile.open(archive) as t:
            t.extractall(tmp, filter='data')
    # Drop a single top-level directory, as in the Zig release tarballs.
    entries = list(tmp.iterdir())
    if len(entries) == 1 and entries[0].is_dir():
        entries[0].rename(dest)
        tmp.rmdir()
    else:
        tmp.rename(dest)


def fetch_download(dep):
    target = ROOT / dep.target_folder
    target.parent.mkdir(parents=True, exist_ok=True)
    download = target.with_name(target.name + '.download')
    with urllib.request.urlopen(dep.source_url) as r, open(download, 'wb') as f:
        shutil.copyfileobj(r, f)
    actual = sha256_of(download)
    if actual != dep.checksum:
        download.unlink()
        sys.exit(f'{dep.target_folder}: SHA-256 mismatch: expected {dep.checksum}, got {actual}')
    if target.suffix in ('.tgz', '.zip'):
        extract(download, target.with_suffix(''))
        download.unlink()
    else:
        download.chmod(0o755)
        download.rename(target)


def fetch_git(dep):
    target = ROOT / dep.target_folder
    shutil.rmtree(target, ignore_errors=True)
    target.mkdir(parents=True)

    def git(*args):
        subprocess.run(['git', '-C', str(target), *args], check=True)

    git('init', '-q')
    git('fetch', '-q', '--depth', '1', dep.source_url, dep.checksum)
    git('checkout', '-q', dep.checksum)


def main():
    for dep in BUILD_DEPS:
        if is_up_to_date(dep):
            print(f'{dep.target_folder}: up to date')
            continue
        print(f'{dep.target_folder}: fetching {dep.source_url}')
        if dep.source_url.endswith('.git'):
            fetch_git(dep)
        else:
            fetch_download(dep)
        stamp_path(dep).write_text(dep.checksum + '\n')


if __name__ == '__main__':
    main()
